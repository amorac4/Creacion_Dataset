FROM samples
GROUP BY familia_probable
ORDER BY cantidad_muestras DESC;
</sql><sql name="fragtor.sql" filename="C:/Users/ADOLF/Desktop/Repositorios/Creacion_Dataset/Dataset_V1/Excel/fragtor.sql">-- Reference to file &quot;C:/Users/ADOLF/Desktop/Repositorios/Creacion_Dataset/Dataset_V1/Excel/fragtor.sql&quot; (not supported by this version) --</sql><sql name="SQL 2* (1)*">SELECT hash_md5, lote_origen, familia_probable, tipo_probable, detection_percent, fecha_escaneo_vt, fecha_creacion_archivo
FROM samples
WHERE familia_probable = 'sabsik'
ORDER BY fecha_creacion_archivo;</sql><sql name="SQL 2* (1)* (1)*">SELECT hash_md5, lote_origen, familia_probable, tipo_probable, detection_percent, fecha_escaneo_vt, fecha_creacion_archivo
FROM samples
