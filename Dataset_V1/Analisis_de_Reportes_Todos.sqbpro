AND lote_origen ='VirusShare_00495'
ORDER BY fecha_creacion_archivo;</sql><sql name="SQL 2* (1)* (1)* (1)*">SELECT hash_md5, lote_origen, familia_probable, tipo_probable, detection_percent, fecha_escaneo_vt, fecha_creacion_archivo
